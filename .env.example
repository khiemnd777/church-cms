# Copy is unnecessary: bun run local:setup creates .env and local-only secrets.
APP_ORIGIN=https://localhost:3443
APP_PORT=3443
MONGO_URL=mongodb://127.0.0.1:27119/?replicaSet=church-local&directConnection=true
MONGO_DB=church_cms_local
REDIS_URL=redis://127.0.0.1:6391
# Generated by local:setup; never use this placeholder as a key.
CSRF_KEY=
TLS_CERT=.local/localhost.pem
TLS_KEY=.local/localhost-key.pem
