{
  "name": "church-cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.1",
  "scripts": {
    "local:setup": "bun scripts/local-setup.ts",
    "db:init": "bun scripts/db-init.ts",
    "owner": "bun scripts/owner.ts",
    "dev": "bun run build && bun api/main.ts",
    "start": "bun api/main.ts",
    "build": "vite build",
    "build:ui": "vite build --mode ui-reference",
    "ui:check": "bun scripts/ui-standard-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check api web scripts tests vite.config.ts",
    "format": "biome check --write api web scripts tests vite.config.ts",
    "test": "bun test tests",
    "benchmark": "bun scripts/benchmark.ts",
    "test:browser": "bash scripts/browser-check.sh",
    "test:browser:p1.2": "bash scripts/browser-check.sh browser-churches.ts",
    "test:ui": "bash scripts/browser-check.sh browser-ui-standard.ts",
    "test:browser:p1.3": "bash scripts/browser-check.sh browser-accounts.ts",
    "qualify:p1.4": "bun scripts/p1-qualification.ts",
    "test:browser:p2.3": "CHURCH_EVIDENCE_DIR=output/p2.3 bash scripts/browser-check.sh browser-families.ts",
    "test:browser:p2.2": "CHURCH_EVIDENCE_DIR=output/p2.2 bash scripts/browser-check.sh browser-members.ts",
    "test:browser:p2.1": "CHURCH_EVIDENCE_DIR=output/p2.1 bash scripts/browser-check.sh browser-organization.ts",
    "test:browser:p1.4": "CHURCH_EVIDENCE_DIR=output/p1.4 bash scripts/browser-check.sh browser-accounts.ts && CHURCH_EVIDENCE_DIR=output/p1.4 bash scripts/browser-check.sh browser-churches.ts && CHURCH_EVIDENCE_DIR=output/p1.4 bash scripts/browser-check.sh browser-check.ts && CHURCH_EVIDENCE_DIR=output/p1.4 bash scripts/browser-check.sh browser-ui-standard.ts",
    "test:browser:p2.4": "CHURCH_EVIDENCE_DIR=output/p2.4/r3 bash scripts/browser-check.sh browser-organization-runtime.ts",
    "test:browser:p2.5": "CHURCH_EVIDENCE_DIR=output/p2.5 bash scripts/browser-check.sh browser-data-exchange.ts",
    "qualify:p2.6": "bun scripts/p2-qualification.ts",
    "qualify:p3.1": "bun scripts/p31-qualification.ts",
    "test:browser:p3.1": "CHURCH_EVIDENCE_DIR=output/p3.1 bash scripts/browser-check.sh browser-attendance.ts",
    "test:browser:p2.6": "CHURCH_EVIDENCE_DIR=output/p2.6 bash scripts/browser-check.sh browser-overview.ts",
    "test:browser:p3.2": "CHURCH_EVIDENCE_DIR=output/p3.2 bash scripts/browser-check.sh browser-qr.ts",
    "qualify:p3.2": "bun scripts/p32-qualification.ts",
    "test:browser:p3.3": "CHURCH_EVIDENCE_DIR=output/p3.3 bash scripts/browser-check.sh browser-prep-classes.ts",
    "qualify:p3.3": "bun scripts/p33-qualification.ts",
    "test:browser:p3.4": "CHURCH_EVIDENCE_DIR=output/p3.4 bash scripts/browser-check.sh browser-rites.ts",
    "qualify:p3.4": "bun scripts/p34-qualification.ts",
    "test:browser:p3.5": "CHURCH_EVIDENCE_DIR=output/p3.5 bash scripts/browser-check.sh browser-certificates.ts",
    "qualify:p3.5": "bun scripts/p35-qualification.ts",
    "test:browser:p3.6": "CHURCH_EVIDENCE_DIR=output/p3.6 bash scripts/browser-check.sh browser-p3-reporting.ts",
    "qualify:p3.6": "bun scripts/p36-qualification.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.2.7",
    "@fontsource/lora": "5.2.8",
    "docx": "9.15.3",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "mongodb": "6.21.0",
    "pdfkit": "0.20.2",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "redis": "5.9.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/bun": "1.3.1",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
